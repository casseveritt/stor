# AWS node host — nodes 0-4 only (no registry, no provider)
# Port convention: base port = 443 + N
#   API (them aggregator) external:  8443+N  → node-N:18443+N
#   web (static files)    external:  6443+N  → /srv/web (served by this Caddy)

(node_web) {
    root * /srv/web

    @root path /
    rewrite @root /index.html

    @callback_html expression `{path} == "/auth/callback" && {query.code} == ""`
    rewrite @callback_html /callback.html

    @api not file
    reverse_proxy @api {args[0]}

    file_server {
        hide .*
    }
}

{$CONTACC_DOMAIN}:6443 {
    import node_web node-0:18443
}
{$CONTACC_DOMAIN}:6444 {
    import node_web node-1:18444
}
{$CONTACC_DOMAIN}:6445 {
    import node_web node-2:18445
}
{$CONTACC_DOMAIN}:6446 {
    import node_web node-3:18446
}
{$CONTACC_DOMAIN}:6447 {
    import node_web node-4:18447
}

{$CONTACC_DOMAIN}:8443 {
    reverse_proxy node-0:18443
}
{$CONTACC_DOMAIN}:8444 {
    reverse_proxy node-1:18444
}
{$CONTACC_DOMAIN}:8445 {
    reverse_proxy node-2:18445
}
{$CONTACC_DOMAIN}:8446 {
    reverse_proxy node-3:18446
}
{$CONTACC_DOMAIN}:8447 {
    reverse_proxy node-4:18447
}
