# Node ports (8443-8452): direct access to the client API.
# Web ports  (8543-8552): presentation layer, proxies to its client internally.
# Convention: web external port = node external port + 100.

{$CONTACC_DOMAIN}:8443 { reverse_proxy client-1:9444 }
{$CONTACC_DOMAIN}:8444 { reverse_proxy client-2:9444 }
