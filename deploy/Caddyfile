# Port convention: last 3 digits of any port minus 443 = node N.
#   them (aggregator) external:  8443+N  (8444–8453)
#   web                external:  6443+N  (6444–6453)
#   them internal:  18443+N
#   me   internal:  28443+N
#   web  internal:  16443+N

{$CONTACC_DOMAIN}:8443 {
    handle /tang/deliver {
        reverse_proxy node-0-me:28443
    }
    reverse_proxy node-0-them:18443
}
{$CONTACC_DOMAIN}:8444 {
    handle /tang/deliver {
        reverse_proxy node-1-me:28444
    }
    reverse_proxy node-1-them:18444
}
{$CONTACC_DOMAIN}:8445 {
    handle /tang/deliver {
        reverse_proxy node-2-me:28445
    }
    reverse_proxy node-2-them:18445
}
{$CONTACC_DOMAIN}:8446 {
    handle /tang/deliver {
        reverse_proxy node-3-me:28446
    }
    reverse_proxy node-3-them:18446
}
{$CONTACC_DOMAIN}:8447 {
