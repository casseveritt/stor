# Presentation layer is served directly from /srv/web (mounted from web/ in the repo).
# Non-file requests (API, setup, auth) are proxied to the client process.
# Auth callback without OAuth params is rewritten to serve web/callback.html.

(node) {
    root * /srv/web

    # Auth callback HTML (no OAuth code) → static page
    @callback_html expression `{path} == "/auth/callback" && {query.code} == ""`
    rewrite @callback_html /callback.html

    # API and any other non-file request → client process
    @api not file
    reverse_proxy @api {args[0]}:9444

    file_server {
        hide .*
    }
}

{$CONTACC_DOMAIN}:8443 {
    import node client-1
}

{$CONTACC_DOMAIN}:8444 {
    import node client-2
}

