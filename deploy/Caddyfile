# Each slot is one external port. Caddy routes to the client process for the
# browser UI and API, and to the server process for federation endpoints.

(slot) {
    @ui path / /api/* /static/* /auth/callback /client/* /setup/*
    handle @ui {
        reverse_proxy {args[1]}
    }
    handle {
        reverse_proxy {args[0]}
    }
}

