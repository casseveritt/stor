# Directory where all persistent data is stored (outside the repo)
# Self-hosted default: ~/contacc
# Cloud: set this to your persistent volume mount point (e.g. /mnt/contacc)
CONTACC_DATA_DIR=~/contacc

# ── Registry operator only ────────────────────────────────────────────────────
# Uncomment these two lines only if you are hosting the shared username registry.
# Most users do not need this — use the public registry at starkville.hopto.org:8421.
# CONTACC_CADDYFILE=./deploy/Caddyfile.registry
# COMPOSE_PROFILES=registry

# Your domain name — server on port 8443, client on port 8444
CONTACC_DOMAIN=your.domain.example

# Passphrase that encrypts the server's database and private key
CONTACC_PASSPHRASE=change-me-to-a-strong-passphrase

# Google OAuth2 credentials (from https://console.cloud.google.com/)
CONTACC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
CONTACC_GOOGLE_CLIENT_SECRET=your-client-secret

# Google identity of the owner account (e.g. google:you@gmail.com)
CONTACC_OWNER_IDENTITY=google:you@example.com
