# Your domain name — both server (port 8443) and client (port 9876) run here
CONTAC_DOMAIN=your.domain.example

# Passphrase that encrypts the server's database and private key
CONTAC_PASSPHRASE=change-me-to-a-strong-passphrase

# Google OAuth2 credentials (from https://console.cloud.google.com/)
CONTAC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
CONTAC_GOOGLE_CLIENT_SECRET=your-client-secret

# Google identity of the owner account (e.g. google:you@gmail.com)
CONTAC_OWNER_IDENTITY=google:you@example.com
