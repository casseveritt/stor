# Directory where all persistent data is stored (outside the repo)
# Self-hosted default: ~/contacc
# Cloud: set this to your persistent volume mount point (e.g. /mnt/contacc)
CONTACC_DATA_DIR=~/contacc

# Your domain name. Each node slot is exposed at
# https://CONTACC_DOMAIN:8443+N (node API) and https://CONTACC_DOMAIN:6443+N (web UI)
CONTACC_DOMAIN=your.domain.example

# Passphrase for dev/testing only — never use in production. Leave unset and use
# the setup wizard's passphrase prompt instead. Per-slot overrides are
# CONTACC_PASSPHRASE_UNSECURE_2, _3, etc. (slot 0/1 share CONTACC_PASSPHRASE_UNSECURE).
# CONTACC_PASSPHRASE_UNSECURE=foobar

# Set to 0 to disable dev mode (defaults to 1, which enables the "foobar" default
# passphrase banner). Production deployments should set this to 0.
# CONTACC_DEV=0

# Registry URL. Defaults to the public registry at strk.xyzw.us:8421 —
# most users do not need to set this.
# CONTACC_IDENTITY_PROXY_URL=https://strk.xyzw.us:8421

# ── Registry operator only ────────────────────────────────────────────────────
# Uncomment these if you are hosting the shared username/handle registry.
# Most users do not need this — use the public registry above.
# COMPOSE_PROFILES=registry
# CONTACC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# CONTACC_GOOGLE_CLIENT_SECRET=your-client-secret
